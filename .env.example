# ---------------------------------------------------------------------------
# Пример настроек. Скопируйте в .env и заполните реальными значениями.
# Файл .env добавлен в .gitignore и не должен попадать в репозиторий.
# ---------------------------------------------------------------------------

# --- ARI: управление вызовом (WebSocket + REST) ----------------------------
ARI_URL=http://sip2.evpanet.com:8088/ari
ARI_USER=ivr_ai
ARI_PASSWORD=change_me
ARI_APP=ivr_ai

# --- AudioSocket: бот слушает TCP, Asterisk подключается к нему -------------
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9092

# --- ExternalMedia: адрес, по которому Asterisk подключается к боту ---------
# Публичный адрес/домен этой машины (НЕ 127.0.0.1) и порт, открытый извне.
# Если пусто, бот возьмёт локальный IPv4 и предупредит в логе.
EXTERNAL_MEDIA_HOST=
EXTERNAL_MEDIA_PORT=9092
EXTERNAL_MEDIA_FORMAT=slin
EXTERNAL_MEDIA_TRANSPORT=tcp
EXTERNAL_MEDIA_ENCAPSULATION=audiosocket
EXTERNAL_MEDIA_TIMEOUT=5

# Принимать TCP-сессии без зарегистрированного вызова (только для отладки)
ALLOW_UNKNOWN_SESSIONS=false

# --- Биллинг: баланс абонента ----------------------------------------------
# POST {"userId": "<лицевой счёт>"} + Authorization: Bearer <BILLING_TOKEN>.
# Ответ: {"found": true, "user": {...}} либо {"found": false, "user": null}.
# BILLING_MOCK=1 — тестовые данные без обращения к сети.
BILLING_BASE_URL=
BILLING_TOKEN=
BILLING_TIMEOUT=10
BILLING_MOCK=0

# --- Речь: AITUNNEL (OpenAI-совместимый API) --------------------------------
# Ключ вида sk-aitunnel-... создаётся в панели AITUNNEL. Без ключа работают
# только DTMF и WAV-промпты.
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
# Зеркало, если основной хост блокируется: https://ru-api.aitunnel.ru/v1

# STT: POST /audio/transcriptions (multipart, language=ru).
# whisper-large-v3-turbo — дешёвый и быстрый; gpt-4o-transcribe — точнее.
STT_MODEL=whisper-large-v3-turbo
SPEECH_LANGUAGE=ru
SPEECH_TIMEOUT=20

# TTS: POST /audio/speech. PCM 24 кГц потоково переводим в 8 кГц для Asterisk.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
TTS_FORMAT=pcm
TTS_PCM_RATE=24000

# --- LLM и инструменты: AITUNNEL /chat/completions --------------------------
# Используется тот же AITUNNEL_API_KEY. Без ключа LLM-шаги работают только
# по DTMF и voice-командам сценария.
LLM_MODEL=gpt-4o-mini
# Системный support_evp.md и справочники billing_account_data.md,
# connection_terms.md, internet_private.md.
LLM_PROMPTS_DIR=prompts/llm
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=300
LLM_TIMEOUT=30
# Сколько раундов function calling разрешено на одну реплику.
LLM_MAX_TOOL_ROUNDS=4
# Сколько сообщений истории хранить в разговоре.
LLM_HISTORY_MESSAGES=40

# --- VAD, эндпоинтинг и barge-in -------------------------------------------
VOICE_INPUT=true
# Останавливать промпт/TTS, когда абонент начал говорить.
VOICE_BARGE_IN=true
# Начало речи — после стольких мс громких кадров подряд.
VAD_START_MS=160
# Конец реплики — после стольких мс тишины.
VAD_SILENCE_MS=700
# Реплики короче порога игнорируются.
VAD_MIN_SPEECH_MS=200
# Минимальный RMS кадра (16-бит) и запас над шумовой дорожкой.
VAD_RMS_THRESHOLD=300
VAD_NOISE_MULTIPLIER=2.5
# Промежуточные гипотезы STT во время речи; 0 — только финальный запрос.
STT_PARTIAL_INTERVAL_MS=1200

# --- Сценарий и аудио ------------------------------------------------------
# default.json — меню + LLM; llm-first.json — свободный диалог без меню
# (скрытые DTMF-переходы 1/2/3/0).
SCENARIO_PATH=scenarios/default.json
# Каталог с WAV-промптами (16-бит PCM, моно; 8/16/22.05/44.1/48 кГц — приведём сами)
PROMPTS_DIR=prompts/placeholder

# --- Записи разговоров -----------------------------------------------------
RECORDINGS_DIR=recordings
RECORD_CALLS=true

# --- Таймауты, секунды -----------------------------------------------------
INIT_TIMEOUT=10
IDLE_TIMEOUT=30
MAX_CALL_SECONDS=600

# --- Прочее ----------------------------------------------------------------
LOG_LEVEL=INFO
