; ---------------------------------------------------------------------------
; Пользователь ARI для бота (понадобится на этапе управления вызовом).
; Файл: /etc/asterisk/ari.conf
;
; Пароль хранится в .env (переменная ARI_PASSWORD), в git он не попадает.
; Сгенерируйте свой пароль, например: openssl rand -base64 24
; ---------------------------------------------------------------------------

[general]
enabled = yes

[ivr_ai]
type = user
read_only = no
password_format = plain
password = change_me
