; ---------------------------------------------------------------------------
; Пример диалплана для голосового бота на AudioSocket.
;
; Как это работает:
;   1) абонент звонит на 777;
;   2) Answer() — AudioSocket не отвечает на вызов автоматически;
;   3) AudioSocket(uuid,host:port) открывает TCP-соединение к боту
;      и передаёт звук в обе стороны (16-бит PCM, 8 кГц, моно);
;   4) бот проигрывает промпты, принимает DTMF и сам закрывает соединение,
;      когда сценарий завершён.
;
; ВАЖНО: адрес и порт должны указывать на машину, где запущен бот
; (AUDIOSOCKET_HOST/AUDIOSOCKET_PORT, по умолчанию 0.0.0.0:9092).
;
; Требуется модуль chan_audiosocket (Asterisk 13+), см. asterisk/modules.conf.sample
; ---------------------------------------------------------------------------

[ivr_ai]
exten => 777,1,NoOp(IVR AI: входящий вызов от ${CALLERID(num)})
 same => n,Answer()
 same => n,Set(CHANNEL(language)=ru)
 same => n,Set(AUDIOSOCKET_UUID=${UUID()})
 same => n,Verbose(1,ivr_ai: подключаемся к боту, UUID=${AUDIOSOCKET_UUID})
 same => n,AudioSocket(${AUDIOSOCKET_UUID},127.0.0.1:9092)
 same => n,Verbose(1,ivr_ai: бот завершил диалог, причина=${HANGUPCAUSE})
 same => n,Hangup()

; ---------------------------------------------------------------------------
; Следующий этап: управление вызовом через ARI (Stasis) + AudioSocket.
; Бот отвечает на StasisStart, делает POST /channels/{id}/continue на метку
; audiosocket, после чего звук уходит в AudioSocket, а вызовом управляем по REST.
;
; exten => 778,1,Stasis(ivr_ai)
;  same => n(audiosocket),AudioSocket(${UUID()},127.0.0.1:9092)
;  same => n,Hangup()
; ---------------------------------------------------------------------------
