{
  "name": "llm-first",
  "description": "Свободный голосовой диалог без меню",
  "initial": "greeting",
  "steps": {
    "greeting": {
      "label": "приветствие",
      "prompt": "greeting.wav",
      "next": "dialog"
    },
    "dialog": {
      "label": "свободный диалог",
      "prompt": "dialog.wav",
      "text": "Чем я могу помочь?",
      "llm": true,
      "timeout_ms": 8000,
      "max_attempts": 2,
      "voice": {
        "оператор": "operator",
        "соедините с оператором": "operator"
      },
      "on_invalid": "no_input",
      "on_timeout": "no_input"
    },
    "no_input": {
      "label": "нет ввода",
      "prompt": "no_input.wav",
      "next": "fallback"
    },
    "operator": {
      "label": "соединение с оператором",
      "prompt": "operator.wav",
      "hangup": true
    },
    "fallback": {
      "label": "завершение после отсутствия ввода",
      "prompt": "fallback.wav",
      "hangup": true
    }
  }
}
